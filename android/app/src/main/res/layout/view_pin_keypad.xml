<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared PIN keypad, included by the lock screen and by PIN setup.

  Framework views only, and a flat hierarchy, because the lock screen has to
  inflate and be usable the instant it appears over a protected app.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/key_1"
            style="@style/PinKey"
            android:text="1" />

        <TextView
            android:id="@+id/key_2"
            style="@style/PinKey"
            android:text="2" />

        <TextView
            android:id="@+id/key_3"
            style="@style/PinKey"
            android:text="3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/key_4"
            style="@style/PinKey"
            android:text="4" />

        <TextView
            android:id="@+id/key_5"
            style="@style/PinKey"
            android:text="5" />

        <TextView
            android:id="@+id/key_6"
            style="@style/PinKey"
            android:text="6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/key_7"
            style="@style/PinKey"
            android:text="7" />

        <TextView
            android:id="@+id/key_8"
            style="@style/PinKey"
            android:text="8" />

        <TextView
            android:id="@+id/key_9"
            style="@style/PinKey"
            android:text="9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/key_biometric"
            style="@style/PinKeyAction"
            android:contentDescription="@string/lock_use_biometric"
            android:src="@drawable/ic_pin_fingerprint"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/key_0"
            style="@style/PinKey"
            android:text="0" />

        <ImageView
            android:id="@+id/key_delete"
            style="@style/PinKeyAction"
            android:contentDescription="@string/lock_delete_digit"
            android:src="@drawable/ic_pin_backspace" />
    </LinearLayout>
</merge>
