<?xml version="1.0" encoding="utf-8"?>
<!--
  The shield that covers a protected app while the real lock screen starts.

  Deliberately trivial: a solid background and the brand mark, nothing that needs
  measuring or decoding, so it can be inflated and drawn in a frame.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lock_background">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:alpha="0.35"
        android:contentDescription="@null"
        android:src="@drawable/ic_guard_shield"
        android:tint="@color/lock_accent" />
</FrameLayout>
