<?xml version="1.0" encoding="utf-8"?>
<!--
  Lock screen layout.

  Framework views only: the project carries no Material dependency for UI, and a
  flat hierarchy is part of what keeps this screen fast to inflate.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lock_background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- Branding -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/lock_badge_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_guard_shield"
            android:tint="@color/lock_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="@string/brand_name"
            android:textColor="@color/lock_accent"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Locked app and PIN state -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/lock_icon_backdrop">

            <ImageView
                android:id="@+id/lock_app_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/lock_app_icon_description" />
        </FrameLayout>

        <TextView
            android:id="@+id/lock_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/lock_text_primary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/lock_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/lock_enter_pin"
            android:textColor="@color/lock_text_secondary"
            android:textSize="14sp" />

        <!-- PIN dots, filled in from code as digits are typed -->
        <LinearLayout
            android:id="@+id/lock_pin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:minHeight="16dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/lock_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:minHeight="20dp"
            android:textColor="@color/lock_error"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Keypad -->
    <LinearLayout
        android:id="@+id/lock_keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_pin_keypad" />
    </LinearLayout>

    <!-- Shown instead of the keypad when no PIN has been created yet -->
    <LinearLayout
        android:id="@+id/lock_no_pin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lock_no_pin_message"
            android:textColor="@color/lock_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/lock_open_app"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/lock_unlock_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/lock_open_samir_lock"
            android:textAllCaps="false"
            android:textColor="@color/lock_on_accent"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
