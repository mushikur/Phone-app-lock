<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: the brand gradient, as a shape so it stays sharp
     at every launcher size and shape. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FF4C5BD4"
        android:endColor="#FF7C3AED"
        android:type="linear" />
</shape>
